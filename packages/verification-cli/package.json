{
  "name": "@splitin/verification-cli",
  "version": "0.1.0-beta.1",
  "description": "CLI for initializing, validating, diagnosing, and certifying self-hosted verification adapters.",
  "license": "MIT",
  "author": "SplitInTech, @ojchavan",
  "homepage": "https://github.com/splitintech/verification-adapter-sdk/tree/main/packages/verification-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitintech/verification-adapter-sdk.git",
    "directory": "packages/verification-cli"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "splitin-verification": "./dist/cli.js"
  },
  "main": "./dist/cli.cjs",
  "module": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "files": [
    "dist",
    "migrations",
    "LICENSE",
    "NOTICE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@splitin/verification-adapter-sdk": "0.1.0-beta.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/splitintech/verification-adapter-sdk/issues"
  }
}
